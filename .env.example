# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ROOMLY
API_URL=http://localhost:4000

# Database
DATABASE_URL=postgresql://roomly:roomly@localhost:5432/roomly_db

# Redis
REDIS_URL=redis://localhost:6379

# Auth / JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your_refresh_secret_here

# Razorpay (Sandbox)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Razorpay Route (Escrow/Split Settlement)
RAZORPAY_ROUTE_ENABLED=true

# KYC — Signzy (Sandbox)
SIGNZY_API_KEY=your_signzy_key
SIGNZY_BASE_URL=https://preproduction.signzy.app/api/v3

# E-Sign — Digio (Sandbox)
DIGIO_CLIENT_ID=your_digio_client_id
DIGIO_CLIENT_SECRET=your_digio_secret
DIGIO_BASE_URL=https://ext.digio.in:444
DIGIO_ENVIRONMENT=sandbox

# WhatsApp — AiSensy (Sandbox)
AISENSY_API_KEY=your_aisensy_key
AISENSY_BASE_URL=https://backend.aisensy.com/campaign/t1/api/v2

# SMS — MSG91
MSG91_AUTH_KEY=your_msg91_key
MSG91_TEMPLATE_ID=your_otp_template

# Email — Amazon SES
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
SES_FROM_EMAIL=noreply@roomly.in

# AWS S3
S3_BUCKET_NAME=roomly-assets
S3_REGION=ap-south-1
CLOUDFRONT_URL=https://your-cloudfront-url.cloudfront.net

# Mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token

# Algolia Search
NEXT_PUBLIC_ALGOLIA_APP_ID=your_app_id
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=your_search_key
ALGOLIA_ADMIN_KEY=your_admin_key
ALGOLIA_INDEX_NAME=roomly_properties

# Google Maps (fallback)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your_google_maps_key

# App Security
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
